# colcon build output — regenerated by `colcon build`, never committed.
# These bake in absolute paths from the machine that built them, so a
# committed copy actively misleads anyone who clones the repo.
build/
install/
log/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# `ros2 run tf2_tools view_frames` output — throwaway debug dumps.
frames*.gv
frames*.pdf

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
